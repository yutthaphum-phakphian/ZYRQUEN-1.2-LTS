# Required
CODEVOICE_BASE_URL=http://127.0.0.1:3000
ZYRQUEN_BASE_URL=http://127.0.0.1:3001
ZYRQUEN_USER_ID=replace-with-authenticated-user-id

# Optional
CODEVOICE_HEALTH_PATH=/api/health
ZYRQUEN_HEALTH_PATH=/api/health
CODEVOICE_PROPOSAL_PATH=/api/ai/workspace
BRIDGE_TIMEOUT_MS=10000
BRIDGE_OBJECTIVE=Verify CodeVoice AI to ZYRQUEN governed execution handoff
ZYRQUEN_PROJECT=codevoice-bridge
ZYRQUEN_AGENT_ID=codevoice-ai

# Set only when you intentionally want the bridge to approve the governed run.
# ZYRQUEN_AUTH_TOKEN=...
# BRIDGE_AUTO_APPROVE=1
# BRIDGE_SKIP_PROPOSAL=1
