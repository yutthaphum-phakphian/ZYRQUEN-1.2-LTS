    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "npx tsx --test tests/unit/*.test.ts && npx vitest run tests/court-evidence-dossier-generator.test.ts",
    "test:vitest": "vitest run",
    "benchmark": "node scripts/benchmark.js",
    "report:perf": "node scripts/report-perf.js",
    "gatekeeper": "node scripts/check-threshold.js"
  },
